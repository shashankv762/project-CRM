// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// 1. TENANT & USER MANAGEMENT
// ---------------------------------------------------------------------

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  avatarUrl       String?
  isActive        Boolean  @default(true)
  timezone        String?  @default("UTC")
  language        String?  @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  memberships     OrganizationMember[]
  ownedOrgs       Organization[]       @relation("OrgOwner")
  activities      ActivityLog[]
  auditLogs       AuditLog[]
  assignedTasks   Task[]               @relation("TaskAssignee")
  notifications   Notification[]
  
  ownedCompanies  Company[]            @relation("CompanyOwner")
  ownedContacts   Contact[]            @relation("ContactOwner")
  ownedLeads      Lead[]               @relation("LeadOwner")
  ownedDeals      Deal[]               @relation("DealOwner")
  authoredNotes   Note[]               @relation("UserNotes")

  // Phase 5
  createdReports  Report[]             @relation("ReportCreator")
  authoredDocs    Document[]           @relation("DocumentAuthor")
  authoredArts    KnowledgeArticle[]   @relation("ArticleAuthor")
}

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  ownerId         String
  owner           User     @relation("OrgOwner", fields: [ownerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Tenant Isolation References
  members         OrganizationMember[]
  teams           Team[]
  roles           Role[]
  subscription    Subscription?
  settings        OrganizationSettings?
  auditLogs       AuditLog[]
  activities      ActivityLog[]
  contacts        Contact[]
  deals           Deal[]
  tasks           Task[]
  workflows       Workflow[]
  aiInsights      AIInsight[]
  integrations    IntegrationToken[]
  apiKeys         ApiKey[]
  companies       Company[]
  leads           Lead[]

  // Phase 5
  customerHealths CustomerHealth[]
  customerSubs    CustomerSubscription[]
  reports         Report[]
  documents       Document[]
  knowledgeArts   KnowledgeArticle[]
  webhooks        Webhook[]
  slaPolicies     SLAPolicy[]
  pipelines       Pipeline[]
  notes           Note[]
  tags            Tag[]
}

model OrganizationMember {
  id              String       @id @default(uuid())
  userId          String
  organizationId  String
  roleId          String
  
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            Role         @relation(fields: [roleId], references: [id])
  
  teamId          String?
  team            Team?        @relation(fields: [teamId], references: [id])
  
  joinedAt        DateTime     @default(now())
  
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ---------------------------------------------------------------------
// 2. RBAC & PERMISSIONS
// ---------------------------------------------------------------------

model Role {
  id              String               @id @default(uuid())
  name            String               // e.g., "Admin", "Sales Manager", "Rep"
  description     String?
  isSystem        Boolean              @default(false)
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  permissions     Permission[]
  members         OrganizationMember[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([name, organizationId])
}

model Permission {
  id              String   @id @default(uuid())
  action          String   // e.g., "read:deals", "write:contacts"
  roleId          String
  role            Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([action, roleId])
}

model Team {
  id              String               @id @default(uuid())
  name            String
  description     String?
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  managerId       String?              // Can refer to an OrganizationMember id
  members         OrganizationMember[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

// ---------------------------------------------------------------------
// 3. SAAS INFRASTRUCTURE & SETTINGS
// ---------------------------------------------------------------------

model Subscription {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  planTier        String       @default("FREE") // FREE, PRO, ENTERPRISE
  status          String       @default("ACTIVE") // ACTIVE, CANCELED, PAST_DUE
  stripeCustomerId String?
  stripeSubId     String?
  billingCycle    String       @default("MONTHLY") // MONTHLY, YEARLY
  seatLimit       Int          @default(5)
  features        String       // JSON string of enabled features

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime  @default(now())

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OrganizationSettings {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  timezone        String       @default("UTC")
  dateFormat      String       @default("YYYY-MM-DD")
  currency        String       @default("USD")
  brandingColor   String       @default("#4f46e5")
  aiEnabled       Boolean      @default(true)
  
  updatedAt       DateTime     @updatedAt
}

model ApiKey {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  keyHash         String       @unique
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
}

// ---------------------------------------------------------------------
// 4. AUDIT & ACTIVITY & NOTIFICATIONS
// ---------------------------------------------------------------------

model AuditLog {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action          String       // e.g., "user.invited", "deal.deleted"
  resourceType    String
  resourceId      String
  ipAddress       String?
  userAgent       String?
  details         String?      // JSON payload of changes

  createdAt       DateTime     @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

model ActivityLog {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  type            String       // e.g., "note", "call", "email"
  entityType      String       // e.g., "deal", "contact"
  entityId        String
  content         String
  metadata        String?      // JSON

  createdAt       DateTime     @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
}

model Notification {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String
  message         String
  type            String       // alert, mention, system
  read            Boolean      @default(false)
  actionUrl       String?

  createdAt       DateTime     @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------
// 5. CORE CRM DOMAIN
// ---------------------------------------------------------------------

model Company {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  domain          String?
  industry        String?
  employeeCount   Int?
  revenue         Float?
  address         String?
  website         String?
  socialLinks     String? // JSON
  
  ownerId         String?
  owner           User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  
  contacts        Contact[]
  deals           Deal[]
  leads           Lead[]
  notes           Note[]
  tags            TagLink[]
  tasks           Task[]       @relation("CompanyTasks")

  // Phase 5
  customerHealth  CustomerHealth?
  subscriptions   CustomerSubscription[]
  documents       Document[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([domain])
}

model Contact {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  firstName       String
  lastName        String
  email           String?
  phone           String?
  alternatePhone  String?
  jobTitle        String?
  department      String?
  address         String?
  timezone        String?
  socialLinks     String? // JSON
  
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  ownerId         String?
  owner           User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  
  lifecycleStage  String       @default("lead") // subscriber, lead, mql, sql, opportunity, customer, evangelist
  source          String?
  
  healthScore     Int?
  churnRisk       String?
  
  deals           DealContact[]
  notes           Note[]
  tags            TagLink[]
  tasks           Task[]       @relation("ContactTasks")

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Lead {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  source          String?
  status          String       @default("New") // New, Contacted, Qualified, Proposal Sent, Negotiation, Converted, Lost
  score           Int          @default(0)
  estimatedValue  Float?
  
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  ownerId         String?
  owner           User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  
  notes           Note[]
  tags            TagLink[]
  tasks           Task[]       @relation("LeadTasks")

  lastContacted   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Pipeline {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  isDefault       Boolean      @default(false)
  
  stages          Stage[]
  deals           Deal[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
}

model Stage {
  id              String       @id @default(uuid())
  pipelineId      String
  pipeline        Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  
  name            String
  order           Int          @default(0)
  probability     Int          @default(0)
  
  deals           Deal[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([pipelineId])
}

model Deal {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title           String
  value           Float        @default(0)
  currency        String       @default("USD")
  probability     Int?         
  
  pipelineId      String?
  pipeline        Pipeline?     @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  
  stageId         String?
  stage           Stage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  ownerId         String?
  owner           User?        @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  
  contacts        DealContact[]
  tasks           Task[]       @relation("DealTasks")
  notes           Note[]
  tags            TagLink[]
  documents       Document[]

  expectedCloseAt DateTime?
  closedAt        DateTime?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([stageId])
}

model DealContact {
  dealId          String
  contactId       String
  role            String? // e.g., "Decision Maker", "Influencer"
  
  deal            Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact         Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([dealId, contactId])
}

model Task {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title           String
  description     String?
  type            String       @default("todo") // todo, call, email, meeting
  status          String       @default("pending") // pending, in_progress, completed
  priority        String       @default("medium") // low, medium, high
  
  dueDate         DateTime?
  
  assigneeId      String?
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  companyId       String?
  company         Company?     @relation("CompanyTasks", fields: [companyId], references: [id], onDelete: SetNull)

  contactId       String?
  contact         Contact?     @relation("ContactTasks", fields: [contactId], references: [id], onDelete: SetNull)

  leadId          String?
  lead            Lead?        @relation("LeadTasks", fields: [leadId], references: [id], onDelete: SetNull)

  dealId          String?
  deal            Deal?        @relation("DealTasks", fields: [dealId], references: [id], onDelete: SetNull)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([assigneeId])
  @@index([status])
}

model Note {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  content         String
  
  authorId        String?
  author          User?        @relation("UserNotes", fields: [authorId], references: [id], onDelete: SetNull)

  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  contactId       String?
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  leadId          String?
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  dealId          String?
  deal            Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
}

model Tag {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  color           String       @default("#e2e8f0")
  
  links           TagLink[]

  createdAt       DateTime     @default(now())

  @@unique([organizationId, name])
}

model TagLink {
  id              String       @id @default(uuid())
  tagId           String
  tag             Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  contactId       String?
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  leadId          String?
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  dealId          String?
  deal            Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tagId])
}

// ---------------------------------------------------------------------
// Phase 4: AI & Automation System Models
// ---------------------------------------------------------------------

model Workflow {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  isActive        Boolean  @default(true)
  triggerType     String   // e.g., 'deal_created', 'lead_status_changed'
  triggerConfig   String   @default("{}") // JSON
  actions         String   @default("[]") // JSON array of actions
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executions      WorkflowExecution[]
}

model WorkflowExecution {
  id              String   @id @default(uuid())
  workflowId      String
  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  status          String   // 'success', 'failed', 'pending'
  logs            String?  // JSON
  startedAt       DateTime @default(now())
  completedAt     DateTime?
}

model AIInsight {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  entityType      String   // 'deal', 'lead', 'company'
  entityId        String
  
  type            String   // 'risk', 'opportunity', 'summary', 'score'
  content         String
  score           Float?   // e.g. 0-100
  
  createdAt       DateTime @default(now())
}

model IntegrationToken {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId          String
  provider        String   // 'google', 'microsoft'
  type            String   // 'email', 'calendar'
  accessToken     String
  refreshToken    String?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Phase 5: Enterprise Platform Expansion Models
// ---------------------------------------------------------------------

model CustomerHealth {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  score           Float    // 0-100
  status          String   // 'healthy', 'at_risk', 'churned'
  factors         String   // JSON array of factors affecting score
  lastCalculated  DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CustomerSubscription {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  planName        String
  status          String   // 'active', 'canceled', 'past_due', 'trialing'
  mrr             Float    @default(0)
  billingCycle    String   // 'monthly', 'yearly'
  
  startDate       DateTime
  renewalDate     DateTime?
  cancelDate      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Report {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  type            String   // 'sales', 'productivity', 'custom'
  config          String   // JSON configuration for report structure
  isScheduled     Boolean  @default(false)
  scheduleCron    String?
  
  createdBy       String
  user            User     @relation("ReportCreator", fields: [createdBy], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Document {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title           String
  content         String?  // Rich text or references to S3
  type            String   // 'proposal', 'contract', 'internal', 'other'
  url             String?  // External URL or storage link
  
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id])
  
  authorId        String
  author          User     @relation("DocumentAuthor", fields: [authorId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KnowledgeArticle {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title           String
  content         String   // Text/Markdown
  category        String
  tags            String?  // JSON array
  
  authorId        String
  author          User     @relation("ArticleAuthor", fields: [authorId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Webhook {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  url             String
  events          String   // JSON array of events (e.g., ['deal.created'])
  secret          String?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SLAPolicy {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  targetEntity    String   // 'ticket', 'lead_response'
  timeLimitMins   Int
  escalationRules String   // JSON config
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
